# OpenAI (기사 선정/번역/요약)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Slack Incoming Webhook (권장: 가장 단순)
# 또는 Bot Token + Channel ID 중 하나만 사용해도 됩니다.
# 실제 URL은 .env에만 넣고, 이 파일에는 절대 실키를 적지 마세요.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789
SLACK_ALERT_WEBHOOK_URL=

# 선택: NewsAPI.org
NEWSAPI_KEY=

# 수집 범위
LOOKBACK_HOURS=24
MAX_COLLECTED_ARTICLES=80
TOP_N=10
MARKET_N=8
TZ=Asia/Seoul
COMPANY_NAME=지니언스(Genians)
